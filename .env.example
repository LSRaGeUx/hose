# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Postgres connection string.
#
# Local development: run `npm run db:up` (podman) and use the line below as is.
# Production: the pooled connection string from your Neon project.
DATABASE_URL=postgresql://hose:hose@localhost:5432/hose

# Session signing secret for Better Auth.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin the auth callbacks resolve against.
# http://localhost:3000 in development, the deployed origin in production.
BETTER_AUTH_URL=http://localhost:3000

# Anthropic key for the five-whys engine (https://console.anthropic.com).
#
# Not called ANTHROPIC_API_KEY on purpose: Netlify's Vite plugin claims that
# name for its AI Gateway and overwrites it with its own token, so a key set
# under that name is silently ignored.
HOSE_ANTHROPIC_API_KEY=
