# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Postgres connection string from your Neon project.
# Neon console > your project > Connection string (pooled).
DATABASE_URL=

# Session signing secret for Better Auth.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin the auth callbacks resolve against.
# http://localhost:3000 in development, the deployed origin in production.
BETTER_AUTH_URL=http://localhost:3000

# Anthropic key for the five-whys engine. Required from phase 4 onward.
# https://console.anthropic.com
ANTHROPIC_API_KEY=
